<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/screen_root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F4F2EC">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/brand" android:textColor="#27745A" android:textSize="12sp" android:letterSpacing="0.13" android:textStyle="bold" android:layout_marginTop="12dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/headline" android:textColor="#173D32" android:textSize="38sp" android:fontFamily="sans-serif-black" android:lineSpacingExtra="-2dp" android:layout_marginTop="18dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/subtitle" android:textColor="#56645D" android:textSize="16sp" android:lineSpacingExtra="3dp" android:layout_marginTop="12dp"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@drawable/card_surface" android:layout_marginTop="24dp">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/section_title" android:textColor="#173D32" android:textSize="20sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
   <Button android:id="@+id/export_invoice" style="@style/ExportButton" android:text="@string/invoice"/>
   <Button android:id="@+id/export_report" style="@style/ExportButton" android:text="@string/report"/>
   <Button android:id="@+id/open_compose" style="@style/ExportButton" android:text="@string/compose"/>
   <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ready" android:textColor="#56645D" android:textSize="13sp" android:layout_marginTop="12dp" android:accessibilityLiveRegion="polite"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/preview_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_surface" android:padding="16dp" android:layout_marginTop="20dp" android:visibility="gone">
   <TextView android:id="@+id/page_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#27745A" android:textSize="12sp" android:textStyle="bold"/>
   <ImageView android:id="@+id/pdf_preview" android:layout_width="match_parent" android:layout_height="380dp" android:scaleType="fitCenter" android:contentDescription="@string/preview_desc"/>
   <Button android:id="@+id/next_page" style="@style/ExportButton" android:text="@string/next_page"/>
   <Button android:id="@+id/save_pdf" style="@style/ExportButton" android:text="@string/save_pdf"/>
   <Button android:id="@+id/share_pdf" style="@style/ExportButton" android:text="@string/share_pdf"/>
  </LinearLayout>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/footer" android:textColor="#56645D" android:textSize="12sp" android:lineSpacingExtra="4dp" android:layout_marginTop="24dp" android:layout_marginBottom="16dp"/>
 </LinearLayout>
</ScrollView>