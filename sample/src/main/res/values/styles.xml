        <item name="colorPrimary">#173D32</item>
        <item name="colorPrimaryDark">#F4F2EC</item>
        <item name="colorAccent">#27745A</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">#F4F2EC</item>
        <item name="android:navigationBarColor">#F4F2EC</item>
